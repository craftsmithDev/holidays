{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdn.jsdelivr.net/gh/craftsmithDev/holidays@main/schema/country.schema.json",
  "title": "Country file (data/<cc>/country.yaml)",
  "description": "Country metadata, its regions (ISO 3166-2) and the catalogue of sources the holiday file cites. See docs/format.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "names", "languages", "regions", "sources"],
  "properties": {
    "code": {
      "description": "ISO 3166-1 alpha-2 code, upper case. Must match the folder name (lower case).",
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "names": { "$ref": "#/$defs/names" },
    "languages": {
      "description": "The local languages of the country as BCP 47 tags, most used first. Every holiday name must exist in each of them and in English.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/languageTag" }
    },
    "regions": {
      "description": "First-level subdivisions (ISO 3166-2). Empty list for a country whose holidays never differ by region.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "names"],
        "properties": {
          "code": {
            "description": "Full ISO 3166-2 code, e.g. CH-ZH.",
            "type": "string",
            "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
          },
          "names": { "$ref": "#/$defs/names" }
        }
      }
    },
    "sources": {
      "description": "Source catalogue. Keys are ids that the holiday file cites.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "languageTag": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "names": {
      "description": "Names keyed by BCP 47 language tag. English (en) is required.",
      "type": "object",
      "required": ["en"],
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "accessed"],
      "properties": {
        "title": { "description": "Title of the document or page, in its own language.", "type": "string", "minLength": 1 },
        "publisher": { "description": "Authority or organisation that publishes it.", "type": "string", "minLength": 1 },
        "law": { "description": "Legal citation, e.g. 'SR 822.11, Art. 20a para. 1'.", "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "accessed": { "description": "Date the source was read (YYYY-MM-DD).", "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
