{
    "name": "craftsmith/holidays",
    "description": "Public holidays of 18 Western European countries, national and regional, with the legal source for every day: half days, substitute days, public, bank and observance types. Same data and results as the npm package @craftsmith/holidays.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/craftsmithDev/holidays",
    "support": {
        "issues": "https://github.com/craftsmithDev/holidays/issues",
        "source": "https://github.com/craftsmithDev/holidays"
    },
    "keywords": [
        "holidays",
        "public-holidays",
        "bank-holidays",
        "calendar",
        "europe",
        "iso-3166",
        "switzerland",
        "liechtenstein",
        "germany",
        "austria",
        "france",
        "italy",
        "spain",
        "portugal",
        "united-kingdom",
        "ireland",
        "belgium",
        "netherlands",
        "luxembourg"
    ],
    "authors": [
        {
            "name": "craftsmith"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "craftsmith\\holidays\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "craftsmith\\holidays\\tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
