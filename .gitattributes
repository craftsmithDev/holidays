* text=auto eol=lf

# Not needed in the Composer package (the GitHub archive).
/.github export-ignore
/dist/json export-ignore
/docs export-ignore
/js export-ignore
/scripts export-ignore
/tests export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/phpunit.xml.dist export-ignore
/tsconfig.json export-ignore

# Generated files: collapse them in diffs.
/dist/** linguist-generated=true
/js/data/** linguist-generated=true
/tests/fixtures/rules/** linguist-generated=true
/tests/fixtures/json/** linguist-generated=true
