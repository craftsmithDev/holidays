{
  "name": "@craftsmith/holidays",
  "version": "1.1.0",
  "description": "Public holidays of 18 Western European countries, national and regional, with the legal source for every day: half days, substitute days, public, bank and observance types. Same data and results as the Composer package craftsmith/holidays.",
  "license": "MIT",
  "author": "craftsmith",
  "homepage": "https://github.com/craftsmithDev/holidays#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craftsmithDev/holidays.git"
  },
  "bugs": {
    "url": "https://github.com/craftsmithDev/holidays/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./js/index.d.ts",
      "default": "./js/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./js/index.d.ts",
  "files": [
    "js/",
    "schema/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "holidays",
    "public-holidays",
    "bank-holidays",
    "calendar",
    "europe",
    "iso-3166",
    "switzerland",
    "liechtenstein",
    "germany",
    "austria",
    "france",
    "italy",
    "spain",
    "portugal",
    "united-kingdom",
    "ireland",
    "belgium",
    "netherlands",
    "luxembourg"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/js/*.test.js",
    "test:types": "tsc -p tsconfig.json",
    "compare": "node scripts/compare.mjs"
  },
  "devDependencies": {
    "@craftsmith/regions": "file:../regions",
    "ajv": "^8.20.0",
    "date-holidays": "^3.39.2",
    "js-yaml": "^4.3.2",
    "typescript": "^5.9.3"
  }
}
