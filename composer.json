{
    "name": "craftsmith/holidays",
    "description": "Public holidays of Western Europe with sources: national and regional, half days, substitute days. Same data and results as the npm package @craftsmith/holidays.",
    "type": "library",
    "license": "MIT",
    "keywords": ["holidays", "public holidays", "bank holidays", "calendar", "switzerland", "liechtenstein", "europe"],
    "authors": [{"name": "craftsmith"}],
    "require": {
        "php": ">=8.2",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"craftsmith\\holidays\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"craftsmith\\holidays\\tests\\": "tests/php/"}
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
