    {
      "id": "ie.saint-brigid",
      "names": {
        "en": "Saint Brigid’s Day",
        "ga": "Lá Fhéile Bríde"
      },
      "from": 2023,
      "date": {
        "type": "nthWeekday",
        "month": 2,
        "weekday": "mon",
        "nth": 1,
        "adjust": [
          {
            "when": {
              "sameDateAs": {
                "type": "fixed",
                "month": 2,
                "day": 4
              }
            },
            "offset": -3
          }
        ]
      },
      "observances": [
        {
          "regions": "all",
          "type": "public",
          "sources": [
            "si-50-2022",
            "wrc-public-holidays"
          ],
          "note": "First Monday in February; 1 February when that is a Friday (S.I. 50/2022 regs. 4 and 5). The first Monday is 4 February exactly when 1 February is a Friday."
        }
      ]
    },
